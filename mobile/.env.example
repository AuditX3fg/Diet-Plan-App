# Public HTTPS URL of the Tawazon Supabase Edge Function.
EXPO_PUBLIC_ACCOUNT_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/tawazon-api
EXPO_PUBLIC_RECOVERY_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/tawazon-api
# Publishable values are safe in the app bundle; never place a secret/service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
