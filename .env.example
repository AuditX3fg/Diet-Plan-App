# Public HTTPS URL of the Tawazon Supabase Edge Function.
VITE_ACCOUNT_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/tawazon-api
# Supabase publishable values are safe in the browser; never use a secret/service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Older deployments can continue using this alias.
VITE_RECOVERY_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/tawazon-api
